cmake_minimum_required(VERSION 3.21)
project(rollstuhl_emu VERSION 0.1.0 LANGUAGES CXX)

find_package(Qt6 6.2 REQUIRED COMPONENTS Widgets SerialBus)

qt_add_executable(rollstuhl_emu
    src/main.cpp
)

target_compile_features(rollstuhl_emu PRIVATE cxx_std_17)
target_link_libraries(rollstuhl_emu PRIVATE Qt6::Widgets Qt6::SerialBus)
set_target_properties(rollstuhl_emu PROPERTIES OUTPUT_NAME "rollstuhl.emu")
