#include <QApplication>
#include <QByteArray>
#include <QCanBus>
#include <QCanBusDevice>
#include <QCanBusFrame>
#include <QElapsedTimer>
#include <QLabel>
#include <QMainWindow>
#include <QPushButton>
#include <QTimer>
#include <QVBoxLayout>
#include <QWidget>

#include <cstdint>
#include <memory>
#include <vector>

namespace {
struct PeriodicFrame {
    QCanBusFrame::FrameId id;
    QByteArray data;
    qint64 periodMs;
    qint64 nextMs = 0;
};

QCanBusFrame frame(QCanBusFrame::FrameId id, const QByteArray& data) {
    QCanBusFrame f(id, data);
    f.setFrameType(QCanBusFrame::DataFrame);
    f.setExtendedFrameFormat(id > 0x7FFu);
    return f;
}
}

class MainWindow final : public QMainWindow {
public:
    explicit MainWindow(QString iface) : m_iface(std::move(iface)) {
        auto* central = new QWidget(this);
        auto* layout = new QVBoxLayout(central);
        layout->setContentsMargins(24, 24, 24, 24);
        layout->setSpacing(20);

        m_ifaceLabel = new QLabel(QStringLiteral("CAN: %1").arg(m_iface), central);
        m_ifaceLabel->setAlignment(Qt::AlignCenter);

        m_stateLabel = new QLabel(QStringLiteral("ROLLSTUHL: AUS"), central);
        m_stateLabel->setAlignment(Qt::AlignCenter);
        QFont stateFont = m_stateLabel->font();
        stateFont.setPointSize(24);
        stateFont.setBold(true);
        m_stateLabel->setFont(stateFont);

        m_button = new QPushButton(QStringLiteral("EINSCHALTEN"), central);
        m_button->setMinimumSize(300, 120);
        QFont buttonFont = m_button->font();
        buttonFont.setPointSize(22);
        buttonFont.setBold(true);
        m_button->setFont(buttonFont);

        m_info = new QLabel(QStringLiteral("Nur EIN/AUS – keine Fahr-, Licht- oder Sitzfunktionen"), central);
        m_info->setAlignment(Qt::AlignCenter);
        m_info->setWordWrap(true);

        layout->addWidget(m_ifaceLabel);
        layout->addStretch();
        layout->addWidget(m_stateLabel);
        layout->addWidget(m_button, 0, Qt::AlignCenter);
        layout->addWidget(m_info);
        layout->addStretch();

        setCentralWidget(central);
        setWindowTitle(QStringLiteral("rollstuhl.emu"));
        resize(560, 420);

        // Minimal cyclic bus image taken from the current R-Net capture.
        // OFF sends nothing. ON sends only these already-observed cyclic frames.
        m_periodic = {
            {0x02000300u, QByteArray::fromHex("0000"),             10,   0},
            {0x14300000u, QByteArray::fromHex("0000"),            200,   0},
            {0x140C0001u, QByteArray::fromHex("0000"),            500,   0},
            {0x0C140000u, QByteArray::fromHex("C0"),             1000,   0},
            {0x0C140100u, QByteArray::fromHex("02"),             1000,   0},
            {0x1C0C0000u, QByteArray::fromHex("28"),             1000,   0},
            {0x1C300004u, QByteArray::fromHex("B7AC13002FD20600"),1000,   0},
        };

        m_tick.setInterval(5);
        m_tick.setTimerType(Qt::PreciseTimer);
        connect(&m_tick, &QTimer::timeout, this, [this] { sendDueFrames(); });
        connect(m_button, &QPushButton::clicked, this, [this] { setPowered(!m_powered); });

        openCan();
    }

    ~MainWindow() override {
        m_tick.stop();
        if (m_can) m_can->disconnectDevice();
    }

private:
    void openCan() {
        QString error;
        m_can.reset(QCanBus::instance()->createDevice(QStringLiteral("socketcan"), m_iface, &error));
        if (!m_can) {
            setError(QStringLiteral("SocketCAN kann nicht erzeugt werden: %1").arg(error));
            return;
        }

        if (!m_can->connectDevice()) {
            setError(QStringLiteral("%1 kann nicht geöffnet werden: %2")
                         .arg(m_iface, m_can->errorString()));
            return;
        }

        connect(m_can.get(), &QCanBusDevice::errorOccurred, this,
                [this](QCanBusDevice::CanBusError e) {
                    if (e != QCanBusDevice::NoError)
                        m_info->setText(m_can->errorString());
                });

        // Drain received traffic. Stage 1 deliberately does not answer requests yet.
        connect(m_can.get(), &QCanBusDevice::framesReceived, this, [this] {
            while (m_can && m_can->framesAvailable() > 0)
                (void)m_can->readFrame();
        });

        m_info->setText(QStringLiteral("%1 verbunden – Rollstuhl ist AUS").arg(m_iface));
        m_button->setEnabled(true);
    }

    void setError(const QString& text) {
        m_info->setText(text);
        m_button->setEnabled(false);
        m_stateLabel->setText(QStringLiteral("CAN-FEHLER"));
    }

    void setPowered(bool on) {
        if (!m_can || m_can->state() != QCanBusDevice::ConnectedState) return;
        m_powered = on;
        if (on) {
            m_clock.restart();
            for (auto& p : m_periodic) p.nextMs = 0;
            m_stateLabel->setText(QStringLiteral("ROLLSTUHL: EIN"));
            m_button->setText(QStringLiteral("AUSSCHALTEN"));
            m_info->setText(QStringLiteral("%1: zyklische ON-Telegramme aktiv").arg(m_iface));
            sendDueFrames();
            m_tick.start();
        } else {
            m_tick.stop();
            m_stateLabel->setText(QStringLiteral("ROLLSTUHL: AUS"));
            m_button->setText(QStringLiteral("EINSCHALTEN"));
            m_info->setText(QStringLiteral("%1: keine Rollstuhl-Telegramme").arg(m_iface));
        }
    }

    void sendDueFrames() {
        if (!m_powered || !m_can) return;
        const qint64 now = m_clock.elapsed();
        for (auto& p : m_periodic) {
            if (now < p.nextMs) continue;
            if (!m_can->writeFrame(frame(p.id, p.data))) {
                setError(QStringLiteral("CAN TX fehlgeschlagen: %1").arg(m_can->errorString()));
                m_tick.stop();
                m_powered = false;
                return;
            }
            do { p.nextMs += p.periodMs; } while (p.nextMs <= now);
        }
    }

    QString m_iface;
    std::unique_ptr<QCanBusDevice> m_can;
    QLabel* m_ifaceLabel = nullptr;
    QLabel* m_stateLabel = nullptr;
    QLabel* m_info = nullptr;
    QPushButton* m_button = nullptr;
    QTimer m_tick;
    QElapsedTimer m_clock;
    bool m_powered = false;
    std::vector<PeriodicFrame> m_periodic;
};

int main(int argc, char** argv) {
    QApplication app(argc, argv);
    const QString iface = argc > 1 ? QString::fromLocal8Bit(argv[1]) : QStringLiteral("can1");
    MainWindow w(iface);
    w.show();
    return app.exec();
}
