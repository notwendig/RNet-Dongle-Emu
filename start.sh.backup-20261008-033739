#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="${RNET_ROOT:-$HOME/Projects/RNet-Dongle-Emu}"
APP="$HOME/.wine/drive_c/Program Files (x86)/PG Drives Technology/R-net Programmer OEM Generic"

BUILD_SCRIPT="$ROOT/scripts/build-can0-rollstuhl-emu.sh"
RUN_SCRIPT="$ROOT/scripts/run-can0-rollstuhl-emu.sh"
DEPLOY_SCRIPT="$ROOT/tools/deploy-wine-runtime.sh"

DLL="$ROOT/build/mingw32/ftd2xx.dll"
INI="$APP/ftd2xx-emu.ini"
PROGRAMMER="$APP/RNet Programmer6 OEM.exe"

RUNDIR="$ROOT/run"
BACKEND_LOG="$RUNDIR/can0-rollstuhl-emu.log"
PROGRAMMER_LOG="$RUNDIR/rnet-programmer.log"
BACKEND_PID="$RUNDIR/can0-rollstuhl-emu.pid"
PROGRAMMER_PID="$RUNDIR/rnet-programmer.pid"

die()
{
    echo "FEHLER: $*" >&2
    exit 1
}

pid_alive()
{
    local file="$1"
    [[ -f "$file" ]] || return 1

    local pid
    pid="$(cat "$file" 2>/dev/null || true)"
    [[ "$pid" =~ ^[0-9]+$ ]] || return 1

    kill -0 "$pid" 2>/dev/null
}

set_device_can0()
{
    [[ -f "$INI" ]] || die "INI fehlt: $INI"

    local tmp
    tmp="$(mktemp)"

    awk '
        BEGIN {
            in_emulator = 0
            emulator_seen = 0
            device_written = 0
        }

        /^\[emulator\][[:space:]]*$/ {
            if (in_emulator && !device_written) {
                print "Device=can0"
                device_written = 1
            }

            print
            in_emulator = 1
            emulator_seen = 1
            next
        }

        /^\[[^]]+\][[:space:]]*$/ {
            if (in_emulator && !device_written) {
                print "Device=can0"
                device_written = 1
            }

            print
            in_emulator = 0
            next
        }

        {
            if (in_emulator && $0 ~ /^[[:space:]]*Device[[:space:]]*=/) {
                if (!device_written) {
                    print "Device=can0"
                    device_written = 1
                }
                next
            }

            print
        }

        END {
            if (in_emulator && !device_written) {
                print "Device=can0"
                device_written = 1
            }

            if (!emulator_seen) {
                print ""
                print "[emulator]"
                print "Device=can0"
            }
        }
    ' "$INI" > "$tmp"

    mv -f "$tmp" "$INI"
}

echo "============================================================"
echo " R-Net Testumgebung starten"
echo " Programmer -> FTD2XX -> can0 -> can1 -> rollstuhl.emu"
echo "============================================================"
echo

[[ -d "$ROOT" ]] || die "Projekt fehlt: $ROOT"
cd "$ROOT"

mkdir -p "$RUNDIR"

command -v wine >/dev/null 2>&1 || die "wine wurde nicht gefunden"
command -v ss   >/dev/null 2>&1 || die "ss wurde nicht gefunden"

[[ -f "$RUN_SCRIPT" ]] || die "Startskript fehlt: $RUN_SCRIPT"
[[ -f "$PROGRAMMER" ]] || die "R-Net Programmer fehlt: $PROGRAMMER"

echo "== 1. CAN-Interfaces prüfen =="

ip link show can0 >/dev/null 2>&1 || die "can0 fehlt"
ip link show can1 >/dev/null 2>&1 || die "can1 fehlt"

ip -details link show can0 | sed -n '1,3p'
ip -details link show can1 | sed -n '1,3p'
echo

echo "== 2. DLL bereitstellen =="

if [[ ! -f "$DLL" ]]; then
    [[ -f "$BUILD_SCRIPT" ]] || die "DLL fehlt und Buildskript fehlt: $BUILD_SCRIPT"

    echo "DLL fehlt - baue CAN0/Rollstuhl-Variante ..."
    bash "$BUILD_SCRIPT"
fi

[[ -f "$DLL" ]] || die "Build hat keine DLL erzeugt: $DLL"

if [[ -f "$DEPLOY_SCRIPT" ]]; then
    bash "$DEPLOY_SCRIPT" "$DLL"
else
    echo "Deployskript fehlt - kopiere DLL direkt."
    cp -f "$DLL" "$APP/ftd2xx.dll"
fi

echo

echo "== 3. FTD2XX auf Device=can0 stellen =="

set_device_can0
grep -E '^[[:space:]]*Device[[:space:]]*=' "$INI" || true
echo

echo "== 4. rnet-can-proxy + rollstuhl.emu starten =="

if pid_alive "$BACKEND_PID"; then
    echo "Backend läuft bereits, PID $(cat "$BACKEND_PID")."
else
    rm -f "$BACKEND_PID"

    (
        cd "$ROOT"
        exec bash "$RUN_SCRIPT"
    ) >"$BACKEND_LOG" 2>&1 &

    echo $! > "$BACKEND_PID"
    echo "Backend gestartet, PID $(cat "$BACKEND_PID")"
    echo "Log: $BACKEND_LOG"
fi

echo

echo "== 5. Proxy auf TCP 127.0.0.1:38523 prüfen =="

proxy_ok=0

for _ in {1..50}; do
    if ss -ltn 2>/dev/null | grep -Eq '127\.0\.0\.1:38523|0\.0\.0\.0:38523|\[::\]:38523'; then
        proxy_ok=1
        break
    fi

    if ! pid_alive "$BACKEND_PID"; then
        break
    fi

    sleep 0.1
done

if (( proxy_ok )); then
    echo "OK: rnet-can-proxy hört auf Port 38523."
else
    echo "WARNUNG: Port 38523 ist noch nicht sichtbar."
    echo "Letzte Backend-Ausgabe:"
    tail -n 30 "$BACKEND_LOG" 2>/dev/null || true
    echo
    echo "Der Programmer wird trotzdem gestartet."
fi

echo

echo "== 6. R-Net Programmer unter Wine starten =="

if pid_alive "$PROGRAMMER_PID"; then
    echo "Programmer läuft bereits, PID $(cat "$PROGRAMMER_PID")."
else
    rm -f "$PROGRAMMER_PID"

    (
        cd "$APP"
        exec wine "RNet Programmer6 OEM.exe"
    ) >"$PROGRAMMER_LOG" 2>&1 &

    echo $! > "$PROGRAMMER_PID"
    echo "Programmer gestartet, PID $(cat "$PROGRAMMER_PID")"
    echo "Log: $PROGRAMMER_LOG"
fi

echo
echo "============================================================"
echo " gestartet"
echo
echo " Backend : $BACKEND_LOG"
echo " Wine    : $PROGRAMMER_LOG"
echo " INI     : $INI"
echo " Device  : can0"
echo "============================================================"
