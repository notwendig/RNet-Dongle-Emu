{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "mingw32-release",
      "displayName": "MinGW32 Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/mingw32",
      "toolchainFile": "${sourceDir}/cmake/toolchains/mingw32.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "mingw32-release",
      "configurePreset": "mingw32-release"
    }
  ]
}
